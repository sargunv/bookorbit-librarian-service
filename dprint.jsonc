{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "newLineKind": "lf",
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "gofumpt": {
    "langVersion": "go1.27",
    "modulePath": "github.com/sargunv/bookorbit-librarian-service",
  },
  "exec": { "commands": [] },
  "excludes": ["mise.lock", "go.sum"],
  "plugins": [
    "npm:@dprint/oxc@0.49.0",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20",
  ],
}

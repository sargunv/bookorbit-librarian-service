LISTEN_ADDR=:8080
STATE_PATH=/data/librarian.db
ADMIN_TOKEN=replace-with-at-least-24-random-characters
BOOKORBIT_URL=http://bookorbit:3000/api/v1
BOOKORBIT_MAGIC_LINK_TOKEN=replace-with-application-magic-link-token
MODEL_BASE_URL=https://your-proxy.example/v1
MODEL_API_KEY=replace-with-restricted-key
MODEL_PRIMARY=claude/haiku-5-5
MODEL_FALLBACK=chatgpt/gpt-6.1-terra
METADATA_PROVIDERS=hardcover,goodreads
LIBRARY_ID=1
LIBRARY_ROOT=/books/books
ORIGINALS_ROOT=/books/.librarian-originals
BOOKORBIT_DATABASE_URL=postgres://librarian:replace-password@bookorbit-db:5432/bookorbit?sslmode=disable
WORKERS=1
MAX_ATTEMPTS=3
JOB_TIMEOUT=8m
AUTO_APPLY=false
AUTO_DISCOVER=false
DISCOVERY_INTERVAL=1h
ORGANIZE_FILES=false
